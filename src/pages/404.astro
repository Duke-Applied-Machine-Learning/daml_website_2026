---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found" solidNav>
  <section class="phero phero--404">
    <div class="wrap">
      <div class="phero__inner">
        <span class="badge">Error 404</span>
        <h1 class="h1">This page doesn't exist</h1>
        <p class="phero__lede">
          The link may be out of date, or the page may have moved.
        </p>
        <div class="phero__actions">
          <a class="btn btn--primary" href="/">
            Back to home
            <span class="ico" aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</Base>

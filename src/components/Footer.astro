---
import { navLinks, site } from "@/data/site";
import SocialIcon from "./SocialIcon.astro";

interface Link {
  href: string;
  label: string;
  external?: boolean;
}

interface Props {
  /** Defaults are the main site's; the AITP site passes its own. */
  links?: readonly Link[];
  more?: Link[];
  homeHref?: string;
}

const {
  links = navLinks,
  more = [
    { href: site.aitpUrl, label: "AITP" },
    { href: site.youtube, label: "YouTube", external: true },
    { href: site.joinFormUrl, label: "Mailing list", external: true },
    { href: `mailto:${site.email}`, label: "Contact" },
  ],
  homeHref = "/",
} = Astro.props;

const ext = (l: Link) =>
  l.external ? { target: "_blank", rel: "noopener" } : {};
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <div class="foot__brand">
        <a href={homeHref} class="foot__logo" aria-label={`${site.name} – home`}>
          <span class="foot__mark" aria-hidden="true"></span>
          <span class="foot__word">Duke Applied<br />Machine Learning</span>
        </a>
        <p class="foot__tagline">
          Building machine learning practitioners through structured training
          and real-world projects, from Durham, North Carolina.
        </p>
        <div class="foot__social">
          <a
            href={site.linkedin}
            aria-label={`${site.short} on LinkedIn`}
            target="_blank"
            rel="noopener"
          >
            <SocialIcon name="linkedin" />
          </a>
          <a
            href={site.instagram}
            aria-label={`${site.short} on Instagram`}
            target="_blank"
            rel="noopener"
          >
            <SocialIcon name="instagram" />
          </a>
          <a href={`mailto:${site.email}`} aria-label="Email DAML">
            <SocialIcon name="email" />
          </a>
        </div>
      </div>

      <div class="foot__col">
        <h4>Navigate</h4>
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>

      <div class="foot__col">
        <h4>More</h4>
        {more.map((l) => <a href={l.href} {...ext(l)}>{l.label}</a>)}
      </div>
    </div>

    <div class="foot__bottom">
      <p>© {year} Duke Applied Machine Learning</p>
      <p>
        A Duke University student organization. Not an official publication of
        Duke University.
      </p>
    </div>
  </div>
</footer>

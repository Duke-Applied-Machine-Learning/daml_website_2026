---
import { navLinks, site } from "@/data/site";

interface Link {
  href: string;
  label: string;
  external?: boolean;
}

interface Props {
  /** Defaults are the main site's; the AITP site passes its own. */
  links?: readonly Link[];
  more?: Link[];
  homeHref?: string;
}

const {
  links = navLinks,
  more = [
    { href: site.aitpUrl, label: "AITP", external: true },
    { href: site.youtube, label: "YouTube", external: true },
    { href: site.joinFormUrl, label: "Mailing list", external: true },
    { href: `mailto:${site.email}`, label: "Contact" },
  ],
  homeHref = "/",
} = Astro.props;

const ext = (l: Link) =>
  l.external ? { target: "_blank", rel: "noopener" } : {};
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <div class="foot__brand">
        <a href={homeHref} class="foot__logo" aria-label={`${site.name} – home`}>
          <span class="foot__mark" aria-hidden="true"></span>
          <span class="foot__word">Duke Applied<br />Machine Learning</span>
        </a>
        <p class="foot__tagline">
          Building machine learning practitioners through structured training
          and real-world projects, from Durham, North Carolina.
        </p>
        <div class="foot__social">
          <a
            href={site.linkedin}
            aria-label={`${site.short} on LinkedIn`}
            target="_blank"
            rel="noopener"
          >
            {/* The glyph fills its whole 24-unit box, and it's solid where the
                other two are outlines — padding the viewBox brings it down
                to their optical size. */}
            <svg viewBox="-1.75 -1.75 27.5 27.5" fill="currentColor" aria-hidden="true">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            href={site.instagram}
            aria-label={`${site.short} on Instagram`}
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect
                x="2.5"
                y="2.5"
                width="19"
                height="19"
                rx="5"
                stroke="currentColor"
                stroke-width="1.8"></rect>
              <circle
                cx="12"
                cy="12"
                r="4.3"
                stroke="currentColor"
                stroke-width="1.8"></circle>
              <circle cx="17.8" cy="6.2" r="1.1" fill="currentColor"></circle>
            </svg>
          </a>
          <a href={`mailto:${site.email}`} aria-label="Email DAML">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect
                x="2.5"
                y="4.5"
                width="19"
                height="15"
                rx="2"
                stroke="currentColor"
                stroke-width="1.8"></rect>
              <path
                d="M3 6.5l9 6 9-6"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="foot__col">
        <h4>Navigate</h4>
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>

      <div class="foot__col">
        <h4>More</h4>
        {more.map((l) => <a href={l.href} {...ext(l)}>{l.label}</a>)}
      </div>
    </div>

    <div class="foot__bottom">
      <p>© {year} Duke Applied Machine Learning</p>
      <p>
        A Duke University student organization. Not an official publication of
        Duke University.
      </p>
    </div>
  </div>
</footer>

---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  badge: string;
  /** Allows a <span class="mark"> for the gradient underline. */
  title: string;
  /** Omit to close the hero flush instead of overhanging a photo plate. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** CSS object-position for the plate crop, e.g. "center 80%" to drop a
   *  photo's focus below its middle. */
  imagePosition?: string;
}

const { badge, title, image, imageAlt = "", imagePosition } = Astro.props;
---

<section class:list={["phero", !image && "phero--plain"]}>
  <div class="wrap">
    <div class="phero__inner">
      <span class="badge">{badge}</span>
      <h1 class="h1" set:html={title} />
      <slot name="lede" />
      <div class="phero__actions">
        <slot name="actions" />
      </div>
    </div>

    {
      image && (
        <div class="phero__plate">
          <Image
            src={image}
            alt={imageAlt}
            widths={[900, 1400, 1920]}
            sizes="(max-width: 1240px) 100vw, 1152px"
            loading="eager"
            fetchpriority="high"
            quality={72}
            style={imagePosition && `object-position: ${imagePosition}`}
          />
        </div>
      )
    }
  </div>
</section>

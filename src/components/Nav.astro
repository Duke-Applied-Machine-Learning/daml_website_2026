---
import { navLinks, site } from "@/data/site";
import SocialIcon from "./SocialIcon.astro";

interface Link {
  href: string;
  label: string;
}

interface Props {
  /** Pages that open on a light hero start the bar already settled. */
  solid?: boolean;
  /** Defaults are the main site's; the AITP site passes its own. */
  links?: readonly Link[];
  homeHref?: string;
  cta?: Link;
}

const {
  solid = false,
  links = navLinks,
  homeHref = "/",
  cta = { href: site.joinFormUrl, label: "Join us" },
} = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class:list={["nav", solid && "nav--solid"]} id="nav">
  <div class="nav__inner">
    <a href={homeHref} class="nav__brand" aria-label={`${site.name} – home`}>
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="nav__word">Duke Applied<br />Machine Learning</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={here === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a href={cta.href} class="nav__cta" target="_blank" rel="noopener">
      {cta.label}
    </a>

    <button
      class="nav__toggle"
      id="nav-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-overlay"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="menu" id="nav-overlay" hidden>
  <nav class="menu__links" aria-label="Mobile">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <div class="menu__foot">
    <a class="menu__cta" href={cta.href} target="_blank" rel="noopener">
      {cta.label}
    </a>
    <a
      class="menu__social"
      href={site.linkedin}
      aria-label={`${site.short} on LinkedIn`}
      target="_blank"
      rel="noopener"
    >
      <SocialIcon name="linkedin" />
    </a>
    <a
      class="menu__social"
      href={site.instagram}
      aria-label={`${site.short} on Instagram`}
      target="_blank"
      rel="noopener"
    >
      <SocialIcon name="instagram" />
    </a>
  </div>
</div>

{
  /* Inline so it runs during parse: a deferred module would let a page loaded
     already-scrolled paint white type on the light bar for a frame. */
}
{
  !solid && (
    <script is:inline>
      (() => {
        const nav = document.getElementById("nav");
        if (!nav) return;

        // The one number to tune: px of scroll over which the bar's light
        // ground arrives. The type crossover scales off it.
        const GROUND_END = 300;
        const FADE_FROM = GROUND_END * 0.12;
        const FADE_TO = GROUND_END * 0.34;

        const clamp01 = (n) => (n < 0 ? 0 : n > 1 ? 1 : n);
        // smoothstep, so neither the departure from white nor the arrival at
        // ink has a visible corner
        const smooth = (n) => n * n * (3 - 2 * n);

        // Where the bar should be for the current scroll position.
        const goal = () => {
          const y = Math.max(window.scrollY, 0);
          const t = clamp01((y - FADE_FROM) / (FADE_TO - FADE_FROM));
          return [clamp01(y / GROUND_END), smooth(t)];
        };

        // The bar eases toward its goal here, frame by frame, rather than
        // through CSS transitions. A transition restarted on every scroll
        // event let the wordmark, mark and links (which read --nav-t through
        // --nav-fg) fall a frame out of step with it and flicker. Writing
        // the eased value directly keeps every part of the bar on one value.
        const TAU = 60; // ms; about 95% of the way there in 180ms
        const still = matchMedia("(prefers-reduced-motion: reduce)");
        let [p, t] = goal();
        let last = 0;
        let running = false;

        const write = () => {
          nav.style.setProperty("--nav-p", p.toFixed(4));
          nav.style.setProperty("--nav-t", t.toFixed(4));
        };

        const frame = (now) => {
          const [gp, gt] = goal();
          const dt = last ? now - last : 16; // first frame of a run: one frame
          const k = still.matches ? 1 : 1 - Math.exp(-dt / TAU);
          p += (gp - p) * k;
          t += (gt - t) * k;
          if (Math.abs(gp - p) < 0.001 && Math.abs(gt - t) < 0.001) {
            [p, t] = [gp, gt];
            running = false;
          }
          last = running ? now : 0;
          write();
          if (running) requestAnimationFrame(frame);
        };

        write();
        window.addEventListener(
          "scroll",
          () => {
            if (running) return;
            running = true;
            requestAnimationFrame(frame);
          },
          { passive: true },
        );
      })();
    </script>
  )
}

<script>
  const toggle = document.getElementById("nav-toggle");
  const overlay = document.getElementById("nav-overlay");

  if (toggle && overlay) {
    const setMenu = (open: boolean) => {
      overlay.hidden = !open;
      toggle.classList.toggle("is-open", open);
      document.getElementById("nav")?.classList.toggle("is-menu", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      document.body.classList.toggle("no-scroll", open);
    };

    // `hidden` widened to boolean | "until-found" in newer DOM types, and any
    // truthy value means the menu is currently closed
    toggle.addEventListener("click", () => setMenu(Boolean(overlay.hidden)));
    overlay
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", () => setMenu(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !overlay.hidden) setMenu(false);
    });
  }
</script>
